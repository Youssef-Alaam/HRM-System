# YZH-HR environment
# Copy to .env.local and fill in values for development.

# --- Database (MySQL) ---
# Local dev: mysql://user:password@localhost:3306/yzh_hr
# Hosted (Motion or other): use the connection string from your provider
DATABASE_URL="mysql://root:password@localhost:3306/yzh_hr"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-32-byte-random-string"
# In production: set to https://your-domain.com (or leave unset on Vercel)
AUTH_URL="http://localhost:3000"

# --- App ---
NEXT_PUBLIC_APP_NAME="YZH-HR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Africa/Cairo"

# --- Storage (selfies, photos) ---
# For prototype: writes to ./public/uploads (local filesystem).
# For prod: swap to S3/R2/Supabase Storage and update the storage adapter.
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR="./public/uploads"
